#include<stdio.h>
int main()
{
int a[100],i,n,pos;
printf("enter size of array");
scanf("%d",&n);
printf("enter array element");
for(i=0;i<n;i++)
scanf("%d",&a[i]);
printf("enter posiyion to delete");
scanf("%d",&pos);
for(i=pos-1;i<n-1;i++)
a[i]=a[i+1];
n--;
printf("updated array");
for(i=0;i<n;i++)
printf("%d",a[i]);
return 0;
}
